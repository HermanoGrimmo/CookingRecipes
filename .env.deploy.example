# Vorlage für .env.deploy – auf dem Server kopieren und ausfüllen:
#   cp .env.deploy.example .env.deploy
# Die Datei enthält Zugangsdaten und gehört NICHT ins Repository.

# Symfony-Geheimnis, erzeugen mit: openssl rand -hex 16
APP_SECRET=

# Datenbank (nur im Docker-Netz erreichbar, trotzdem starkes Passwort setzen)
POSTGRES_USER=cooking
POSTGRES_PASSWORD=
POSTGRES_DB=cooking_recipes

# Öffentliche Basis-URL – wird für Links in E-Mails (z. B. Passwort-Reset) genutzt
DEFAULT_URI=https://rezepte.example.de

# Passwort des initialen Admin-Benutzers. Wird nur beim allerersten Deploy von
# der Migration Version20260409222000 gelesen. Danach diese Zeile entfernen.
ADMIN_INITIAL_PASSWORD=

# Transaktionale E-Mails, z. B. Brevo, Mailjet oder ein eigener SMTP-Server.
# Achtung: Hetzner Cloud sperrt ausgehende SMTP-Ports bei neuen Accounts.
MAILER_DSN=smtp://benutzer:passwort@smtp-relay.example.com:587

# User-Agent für den Rezept-Import
HTTP_CLIENT_USER_AGENT="CookingRecipes/1.0 (Rezept-Import auf Nutzeranfrage)"

# Adresse, an die nginx gebunden wird. Bei einem TLS-Proxy auf demselben Host
# 127.0.0.1 belassen; bei einem Proxy im Docker-Netz das Port-Mapping entfernen.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
