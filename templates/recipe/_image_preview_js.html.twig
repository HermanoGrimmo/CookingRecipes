<script>
// Bild-URL-Vorschau für das Rezept-Formular.
// (Das Hinzufügen/Entfernen von Zutaten und Schritten übernimmt jetzt die RecipeForm Live Component.)
document.addEventListener('DOMContentLoaded', () => {
    const imageInput = document.querySelector('input[name$="[imagePath]"]');
    if (!imageInput) return;

    const preview = document.createElement('div');
    preview.className = 'image-preview';
    imageInput.after(preview);

    const render = () => {
        const url = imageInput.value.trim();
        // DOM-API statt innerHTML: verhindert Markup-/Script-Injektion über die eingegebene URL.
        preview.replaceChildren();
        if (url) {
            const img = document.createElement('img');
            img.alt = 'Vorschau';
            img.addEventListener('error', () => { img.style.display = 'none'; });
            img.src = url;
            preview.append(img);
        }
    };
    render();
    imageInput.addEventListener('input', render);
});
</script>
